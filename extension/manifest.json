{
  "manifest_version": 3,
  "name": "Radar de Compras",
  "version": "0.1.0",
  "description": "Calcula el margen de reventa en cada producto de Amazon y vigílalo en tu Radar de Compras.",
  "permissions": ["storage"],
  "host_permissions": ["https://radar-compras-six.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Radar de Compras" },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/*/dp/*", "https://www.amazon.com/dp/*", "https://www.amazon.com/gp/product/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
